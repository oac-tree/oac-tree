<?xml version="1.0" encoding="UTF-8"?>
<Procedure xmlns="http://codac.iter.org/sup/oac-tree" version="1.0"
           name="Usage of For instruction to display the content of an array element by element"
           xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
           xs:schemaLocation="http://codac.iter.org/sup/oac-tree oac-tree.xsd">
    <Sequence>
        <For elementVar="i" arrayVar="arr">
            <Output fromVar="i"/>
        </For>
    </Sequence>
    <Workspace>
        <Local name="arr" type='{"type":"uint32_arr","element":{"type":"uint16"}}' value='[1,2,3]'/>
        <Local name="i" type='{"type":"uint16"}' value='0' />
    </Workspace>
</Procedure>
