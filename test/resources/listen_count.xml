<?xml version="1.0" encoding="UTF-8"?>
<Procedure xmlns="http://codac.iter.org/sup/oac-tree" version="1.0"
           name="Procedure for testing how many times the Listen child is called"
           xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
           xs:schemaLocation="http://codac.iter.org/sup/oac-tree oac-tree.xsd">
    <Sequence isRoot="True">
        <ForceSuccess>
            <Include name="Test Setup of Listen child" path="TestListenCount"/>
        </ForceSuccess>
        <Equals leftVar="count" rightVar="max_val"/>
    </Sequence>
    <ParallelSequence name="TestListenCount">
        <Listen varNames="monitor" blocking="true">
            <Sequence>
                <LessThan leftVar="monitor" rightVar="max_val" />
                <Increment varName="count"/>
            </Sequence>
        </Listen>
        <Repeat maxCount="-1">
            <Sequence>
                <Wait timeout="0.2" blocking="true" />
                <Increment varName="monitor"/>
            </Sequence>
        </Repeat>
    </ParallelSequence>
    <Workspace>
        <Local name="monitor"
               type='{"type":"uint64"}'
               value='0' />
        <Local name="max_val"
               type='{"type":"uint64"}'
               value='5' />
        <Local name="count"
               type='{"type":"uint64"}'
               value='0' />
    </Workspace>
</Procedure>
